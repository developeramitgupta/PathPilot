# Clerk — required in connected environments
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase — publishable key is safe for the browser; never expose the secret key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Prisma — transaction pooler for runtime, session/direct pooler for migrations
DATABASE_URL=
DIRECT_URL=

# AI providers — added to the LangGraph-ready adapter in Milestone 2
OPENAI_API_KEY=
AI_MODEL_STRONG=
AI_MODEL_FAST=
